# Kanso runtime environment — EXAMPLE ONLY.
#
# Copy the rendered example to the service user's Quadlet directory as
# kanso.env, then fill in the secrets:
#
#   sudo install -o __KANSO_USER__ -g __KANSO_USER__ -m 0600 \
#     deploy/out/kanso.env.example \
#     __KANSO_HOME__/.config/containers/systemd/kanso.env
#
# The real file MUST be mode 0600, owned by the service user, and MUST NEVER
# be committed to git. The running container reads it through
# EnvironmentFile=%h/.config/containers/systemd/kanso.env.
#
# KANSO_PASSWORD is the single UI password. The OpenChamber pair is optional:
# the adapter stays disabled unless both values are non-empty. Uncomment and
# fill both lines only when you use the adapter.
KANSO_PASSWORD=
KANSO_DATA_DIR=/data
# Rendered from KANSO_DOMAIN; the committed example is https://kanso.example.com.
KANSO_PUBLIC_URL=__KANSO_PUBLIC_URL__
# KANSO_OPENCHAMBER_URL=http://openchamber.example.com:3000
# KANSO_OPENCHAMBER_TOKEN=
KANSO_LOG=info,kanso=debug
