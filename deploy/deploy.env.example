# Host deployment values. Copy to deploy/deploy.env (gitignored), edit, then
# render the artefacts. Never put secrets here.
#
# The six KANSO_* host values are required by deploy/render.sh; the example.com
# values must be replaced before rendering. KANSO_USER and KANSO_CERT_NAME are
# labels used by the runbook and generated comments.
#
# TLS: exactly one of these, or neither to add TLS by hand after rendering.
# KANSO_TLS_INCLUDE is for an absolute host-managed TLS snippet path.
# KANSO_TLS_SNIPPET is for a self-contained file, for example deploy/tls.conf
# built from deploy/tls.conf.example; relative snippet paths are resolved from
# the repository root.
KANSO_TLS_INCLUDE=
KANSO_TLS_SNIPPET=
KANSO_DOMAIN=kanso.example.com
KANSO_USER=kanso
KANSO_HOME=/var/lib/kanso
KANSO_PORT=8087
KANSO_IMAGE=ghcr.io/dupremathieu/kanso:latest
KANSO_CERT_NAME=example.com-0001
